# Copie para .env e preencha. NUNCA versione o .env.

# --- IA (Claude) ---
# claude_code = usa a sua assinatura do Claude Code (sem API). api = usa ANTHROPIC_API_KEY.
LLM_BACKEND=claude_code
# Token de longa duração gerado por `claude setup-token` (abre o navegador; validade ~1 ano).
CLAUDE_CODE_OAUTH_TOKEN=
# Caminho do claude.exe (vazio = detecta: PATH, %USERPROFILE%\.local\bin, app desktop)
CLAUDE_CLI_PATH=
# Modelos: no backend claude_code use apelidos (sonnet, opus); no backend api use IDs (claude-sonnet-5, claude-opus-5)
LLM_MODEL_PRETRIAGEM=haiku
LLM_MODEL_TRIAGEM=sonnet
LLM_MODEL_ANALISE=opus
LLM_MODEL_REDACAO=opus
ANTHROPIC_API_KEY=

# --- E-mail (Gmail: use uma "senha de app", nao a senha da conta) ---
OWNER_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- Aprovacao por link ---
# Segredo com 32+ caracteres aleatorios (ex.: python -c "import secrets;print(secrets.token_urlsafe(48))")
APPROVAL_SECRET=
# URL publica do endpoint web (Cloudflare Tunnel). Sem isso, a aprovacao usa resposta de e-mail (IMAP).
PUBLIC_BASE_URL=
WEB_HOST=127.0.0.1
WEB_PORT=8765

# --- Seguranca ---
# true = faz tudo menos o clique final de envio. Mude para false SOMENTE quando quiser envios reais.
DRY_RUN=true
# Margens de prazo (minutos) para preparar / enviar propostas
PRAZO_MIN_PREPARAR_MIN=1440
PRAZO_MIN_ENVIAR_MIN=30

# --- Cadência diária ---
# Máximo de licitações enviadas por e-mail por dia (informativas + aprovação). O restante fica na fila, por prazo.
LIMITE_DIARIO_ENVIOS=50
# Hora (0-23, Brasília) do resumo diário com as novas licitações compatíveis e o estado da fila
HORA_RESUMO_DIARIO=8

# --- Caminhos (opcionais) ---
DATA_DIR=data
COFRE_DIR=cofre
CONFIG_DIR=config
TEMPLATES_DIR=templates
